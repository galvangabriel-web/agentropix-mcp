{"version": 2, "width": 100, "height": 44, "timestamp": 1780845808, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "SRL-2018 runbook - CLI subset (live capture)"}
[0.019556, "o", "\r\n\u001b[1;36m== 0. Pre-flight: the installed CLI (run + doctor only; NO evidence-gate) ==\u001b[0m\r\n"]
[0.023058, "o", "\u001b[1;32m$ agentropix-sift --help 2>&1 | sed 's/\\x1b\\[[0-9;]*m//g' | grep -A4 Commands\u001b[0m\r\n"]
[0.715237, "o", "╭─ Commands ───────────────────────────────────────────────────────────────────────────────────────╮\r\n│ run      Run autonomous DFIR triage on an evidence image.                                        │\r\n│ doctor   Check that required SIFT tools are available.                                           │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n\r\n"]
[0.716366, "o", "\u001b[1;33m# the runbook flags this drift: evidence-gate mint is NOT in v0.1.0.dev0 ->\u001b[0m\r\n\u001b[1;32m$ agentropix-sift evidence-gate mint 2>&1 | sed 's/\\x1b\\[[0-9;]*m//g' | grep -i 'no such' || true\u001b[0m\r\n"]
[1.441096, "o", "│ No such command 'evidence-gate'.                                                                 │\r\n"]
[1.442339, "o", "\r\n\u001b[1;36m== 1a. Evidence metadata — ewfinfo (real acquisition hash + examiner) ==\u001b[0m\r\n\u001b[1;32m$ ewfinfo /cases/SRL-2018/base-dc-cdrive.E01 2>&1 | sed -n '4,12p;28,40p'\u001b[0m\r\n"]
[1.527423, "o", "\tCase number:\t\t20180905-001\r\n\tDescription:\t\tbase-dc C-Drive\r\n\tExaminer name:\t\tClint Barton\r\n\tEvidence number:\t \r\n\tNotes:\t\t\tAcquired over network via F-Response\r\n\tAcquisition date:\tFri Sep  7 21:13:10 2018\r\n\tSystem date:\t\tFri Sep  7 21:13:10 2018\r\n\tOperating system used:\tWin 201x\r\n\tSoftware version used:\tADI4.2.0.13\r\n"]
[1.528085, "o", "Digest hash information\r\n\tMD5:\t\t\te18b450127de04afb3211faa456ada27\r\n\tSHA1:\t\t\t15f1215e824a3319020cb74addcbe22d90fc6c18\r\n\r\n"]
[1.575293, "o", "\r\n\u001b[1;36m== 1b. Offset proof — these E01s are VOLUME images (NTFS at offset 0, not 63) ==\u001b[0m\r\n\u001b[1;32m$ fls -i ewf -o 0 /cases/SRL-2018/base-dc-cdrive.E01 2>&1 | head -3\u001b[0m\r\n"]
[3.476911, "o", "d/d 85385-144-1:\tDocuments and Settings\r\nd/d 304-144-6:\tProgramData\r\nd/d 465-144-5:\tUsers\r\n"]
[3.488004, "o", "\u001b[1;33m# offset 63 fails on these volume images:\u001b[0m\r\n\u001b[1;32m$ fls -i ewf -o 63 /cases/SRL-2018/base-dc-cdrive.E01 2>&1 | head -1\u001b[0m\r\n"]
[3.602164, "o", "Cannot determine file system type\r\n"]
[3.622845, "o", "\r\n\u001b[1;36m== 1c. Image type — img_stat ==\u001b[0m\r\n\u001b[1;32m$ img_stat /cases/SRL-2018/base-dc-cdrive.E01 2>&1 | head -7\u001b[0m\r\n"]
[3.69592, "o", "IMAGE FILE INFORMATION\r\n--------------------------------------------\r\nImage Type:\t\tewf\r\n\r\nSize of data in bytes:\t36110860288\r\nSector size:\t512\r\nMD5 hash of data:\te18b450127de04afb3211faa456ada27\r\n"]
[3.701515, "o", "\r\n\u001b[1;36m== 2. Inventory facts — 7 E01, 22 .img, 21 .md5 (one dupe lacks md5) ==\u001b[0m\r\n"]
[3.70223, "o", "\u001b[1;32m$ printf 'E01=%s img=%s md5=%s\\n' $(ls /cases/SRL-2018/*.E01 | wc -l) $(ls /cases/SRL-2018/*.img | wc -l) $(ls /cases/SRL-2018/*.md5 | wc -l)\u001b[0m\r\n"]
[3.739123, "o", "E01=7 img=22 md5=21\r\n"]
[3.739671, "o", "\u001b[1;33m# the one .img with no .md5 sibling:\u001b[0m\r\n\u001b[1;32m$ for i in /cases/SRL-2018/*.img; do b=${i%.img}; [ -f \"$b.md5\" ] || echo \"   NO md5: $(basename $i)\"; done\u001b[0m\r\n"]
[3.748089, "o", "   NO md5: base-wkstn-01-mem.img\r\n"]
[3.748677, "o", "\r\n\u001b[1;36m== 3. Seal verifier is present (off-PATH; runbook gives the absolute path) ==\u001b[0m\r\n\u001b[1;32m$ ls -la /home/admin2/agentropix-sift/scripts/verify_seal.py\u001b[0m\r\n"]
[3.755963, "o", "-rw-rw-r-- 1 admin2 admin2 6080 May 11 22:24 /home/admin2/agentropix-sift/scripts/verify_seal.py\r\n"]
[3.75723, "o", "\r\n\u001b[1;36m== capture complete — CLI subset of the SRL-2018 runbook ==\u001b[0m\r\n"]
